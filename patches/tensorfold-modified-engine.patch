+@pytest.mark.parametrize("top_p", [0.01, 0.5, 0.8, 0.95, 0.99, 1.0 - 2**-40])
+@pytest.mark.parametrize("min_p", [0.0, 0.05, 1.0])
+def test_nucleus_four_shards_match_host(monkeypatch, top_p, min_p):
+    monkeypatch.setenv("TENSORFOLD_NUCLEUS_UNION", "1")
+    monkeypatch.setattr(cs, "NUCLEUS", 8)
+    monkeypatch.setattr(cs, "WIDER", 16)
+    widths, offsets = [1, 41, 19, 37], [0, 1, 42, 61, 98]
+    x = torch.randn(12, sum(widths), generator=torch.Generator().manual_seed(18)).bfloat16() * 3
+    x[::4] = x[::4].round()
+    x[1, :-1] = -torch.inf
+    x[2] = 0  # flat logits exercise ties at the candidate boundary and complete-shard retry
+    positions = [19 * r + 671 for r in range(len(x))]
+    for seed, temp in [(0, 1e-7), (991, 0.3), (-1, 1.0), (2**63 + 77, 2.0)]:
+        s = Sampling(seed, temp, 0, top_p, min_p)
+        monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_NUCLEUS", "0")
