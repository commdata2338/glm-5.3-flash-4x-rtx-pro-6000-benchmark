@@ -0,0 +1,84 @@
+"""Measured service, priority/deadline overrides and completion fences, entirely on the CPU."""
+from types import SimpleNamespace as NS
+
+import pytest
+
+from tensorfold.cuda import priority as p
+from tensorfold.families.glm5_next.cuda import multi
+
+
+@pytest.mark.parametrize("share", [0.25, 0.5, 0.8])
+def test_expensive_chunks_get_equal_weighted_time_not_equal_step_counts(share):
+    credit = p.TimeCredit(share)
+    credit.contend(2)
+    counts = [0, 0]
+    for _ in range(1000):
+        fill = credit.choose()
+        counts[fill] += 1
+        credit.record(fill, 0.4 if fill else 0.02)
+    seconds = credit.seconds
+    assert abs(seconds["prefill"] - share * sum(seconds.values())) <= 0.4
+    assert counts[0] > counts[1]
+
+
+def test_idle_and_class_changes_discard_credit_and_full_share_has_no_division_by_zero():
+    c = p.TimeCredit(0.5)
+    c.contend(2)
+    c.record(True, 1)
+    assert c.balance < 0
+    c.contend(None)
+    c.record(False, 100)
+    c.contend(2)
+    assert c.balance == 0
+    c.record(False, 1)
+    c.contend(0)
+    assert c.balance == 0
+    c = p.TimeCredit(1)
+    c.contend(2)
+    assert c.choose()
+    c.record(True, 1)
+    assert c.choose()
+
+
+def test_release_steps_and_priority_deadlines_still_win():
+    now = [0.0]
+    settings = p.Settings.from_env({"TENSORFOLD_PRIORITY_SHORT_ROWS": "0"})
+    steps = p.Arbiter(settings, 0.5, lambda: now[0])
+    assert [steps.choose(2, 4096, False, 2) for _ in range(4)] == [False, True, False, True]
+    credit = p.TimeCredit(0.5)
+    arb = p.Arbiter(settings, 0.5, lambda: now[0], credit)
+    assert not arb.choose(2, 4096, False, 2)
+    credit.record(False, 1)
+    arb.last_round = 0
+    now[0] = settings.round_gap_s + 1
+    assert not arb.choose(2, 4096, False, 2)  # overdue round, even with ample fill credit
+    arb.rounded()
+    credit.record(True, 10)
+    assert arb.choose(2, 4096, True, 2)       # starvation override, even with fill debt
+    assert not arb.choose(3, 4096, False, 0, hold=True)
+    assert credit.key is None               # cross-class rules remain iteration based
+
+
+def test_time_brackets_wait_for_side_streams_and_steps_do_not_sync(monkeypatch):
+    d = multi.MultiDecoder.__new__(multi.MultiDecoder)
+    d.w = NS(device=NS(type="cuda"))
+    seen = []
+    monkeypatch.setattr(multi.torch.cuda, "synchronize", lambda device: seen.append("sync"))
+    times = iter([2.0, 2.4])
+    monkeypatch.setattr(multi.time, "perf_counter", lambda: next(times))
+    d.time_credit = None
+    assert d._service_start() is None and not seen
