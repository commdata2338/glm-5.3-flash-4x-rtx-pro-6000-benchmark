+"""Operator-only synthetic device gate; no model or service is started.
+
+CPU: python tools/sampler_device_check.py --device cpu
+GPU window: torchrun --standalone --nproc-per-node=4 tools/sampler_device_check.py --device cuda --distributed
+"""
+
+import argparse
+import os
+
+import torch
+
+from tensorfold.cuda import gpu_sample_unbounded as gpu
+from tensorfold.cuda import sampling as host
+from tensorfold.engine.exact_sampling import Sampling
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--device", required=True)
+    parser.add_argument("--distributed", action="store_true")
+    parser.add_argument("--trials", type=int, default=32)
+    args = parser.parse_args()
+    rank, world = 0, 1
+    device = torch.device(args.device)
+    gather = host.one_rank
+    if args.distributed:
+        import torch.distributed as dist
+        rank = int(os.environ["RANK"])
+        if device.type == "cuda":
+            device = torch.device("cuda", int(os.environ["LOCAL_RANK"]))
+            torch.cuda.set_device(device)
+        dist.init_process_group("nccl" if device.type == "cuda" else "gloo")
+        world = dist.get_world_size()
+        def gather(words):
+            got = torch.empty(world * words.numel(), dtype=words.dtype, device=device)
+            dist.all_gather_into_tensor(got, words.contiguous())
+            return got.view(world, -1)
+    os.environ["TENSORFOLD_NUCLEUS_UNION"] = "1"
+    gpu.reset()
+    for kind in ("full", "nucleus"):
+        switch = "TENSORFOLD_GPU_SAMPLE_" + kind.upper()
+        os.environ[switch] = "1"
+        assert gpu.enabled(kind, device, gather), f"{kind} self-check failed"
+        for trial in range(args.trials):
+            g = torch.Generator().manual_seed(731 + trial)
+            x = (torch.randn(8, 4096 * world, generator=g) * 3).bfloat16()
+            x[::3] = x[::3].round()
+            x[1, :-1] = -torch.inf
+            x = x[:, rank*4096:(rank+1)*4096].to(device)
+            s = Sampling(2**63 + trial, [1e-7, 0.3, 1.0, 2.0][trial % 4], 0,
+                         1.0 if kind == "full" else [0.5, 0.95, 0.99][trial % 3],
+                         0.0 if kind == "full" else [0.0, 0.05][trial % 2])
+            positions = list(range(1700 + 17*trial, 1708 + 17*trial))
+            os.environ[switch] = "0"
+            expected = host.nucleus_rows(x, positions, s, offset=rank*4096, gather=gather)
+            os.environ[switch] = "1"
+            actual = host.nucleus_rows(x, positions, s, offset=rank*4096, gather=gather)
+            assert actual == expected, (kind, trial, rank, actual, expected)
+        if rank == 0:
+            print(f"{kind}: {args.trials * 8} rows equal to device-generated release host draws on {world} ranks")
+    if args.distributed:
+        dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
