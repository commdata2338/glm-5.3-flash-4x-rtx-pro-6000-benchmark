+"""The operator's reply gate must compare token IDs and the identical request."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+spec = importlib.util.spec_from_file_location("reply_check", Path(__file__).parents[1] / "tools/sampler_reply_check.py")
+reply_check = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(reply_check)
+
+
+def test_gate_rejects_same_text_different_tokenization():
+    choice = [{"message": {"content": "same", "reasoning_content": "thought"}, "finish_reason": "stop"}]
+    a = {"name": "a", "request_sha256": "abc", "reply": {"token_ids": [1, 2], "choices": choice}}
+    assert reply_check.compare(a, dict(a))
+    assert not reply_check.compare(a, {**a, "reply": {"token_ids": [12], "choices": choice}})
+    assert not reply_check.compare(a, {**a, "request_sha256": "different"})
+
+
+def test_gate_requires_token_ids_and_explicit_seed():
+    with pytest.raises(ValueError, match="token_ids"):
+        reply_check.reply_bits({"choices": []})
+    with pytest.raises(ValueError, match="seed"):
+        reply_check.checked_request({"name": "a", "body": {}})
+    body = dict(seed=7, temperature=1, top_k=0, top_p=0.95, min_p=0, return_token_ids=True)
+    assert reply_check.checked_request({"name": "a", "body": body}) == reply_check.canonical(body)
