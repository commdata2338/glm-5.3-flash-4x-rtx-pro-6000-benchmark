@@ -0,0 +1,78 @@
+"""Cache decisions on the CPU: evidence for misses and the single request-log field."""
+from types import SimpleNamespace as NS
+
+import pytest
+
+from tensorfold.cuda.server import print_done
+from tensorfold.families.glm5_next.cuda.multi import MultiDecoder
+
+
+def decoder():
+    d = MultiDecoder.__new__(MultiDecoder)
+    d.kept, d.lanes, d.evicted_prefixes = [], {}, []
+    d.grid, d.drafts, d.cache_reasons = 64, object(), True
+    d.g = NS(cache_entries=2)
+    return d
+
+
+def snap(n=128, **kw):
+    return NS(**(dict(ids=list(range(n)), drafter_end=n, drafter_rows=[], head=None) | kw))
+
+
+@pytest.mark.parametrize("snapshot,prompt,reason", [
+    (snap(ids=[0, 99] + list(range(2, 128))), list(range(129)), "token_mismatch:1"),
+    (snap(), list(range(80)), "token_mismatch:80"),
+    (snap(127), list(range(129)), "off_grid"),
+    (snap(drafter_rows=None), list(range(129)), "drafter_missing"),
+    (snap(drafter_end=127), list(range(129)), "drafter_missing"),
+    (snap(), list(range(128)), "head_missing"),
+])
+def test_reason_does_not_change_lookup(snapshot, prompt, reason):
+    d = decoder()
+    d.kept = [snapshot]
+    assert d._resume(prompt) is None
+    assert d._cache_miss(prompt) == reason
+    assert d._resume(prompt) is None
+
+
+def test_cold_pending_and_eviction_require_evidence():
+    d = decoder()
+    prompt = list(range(129))
+    assert d._cache_miss(prompt) == "cold"
+    d.lanes[0] = NS(decoding=False, feed=None, s=NS(draft=True, prompt=prompt),
+                    st=NS(pos=0), stops=[128], point=128)
+    assert d._cache_miss(prompt) == "admitted_before_state"
+    d.lanes.clear()
+    d.evicted_prefixes = [(128, d._prefix_fingerprint(prompt[:128]))]
+    assert d._cache_miss(prompt) == "evicted"
+    assert d._cache_miss([9] + prompt[1:]) == "cold"
+
+
+def test_longest_matching_prefix_and_exact_head_replay():
+    d = decoder()
+    d.kept = [snap(64), snap(128), snap(192)]
+    assert d._resume(list(range(129))) is d.kept[1]
+    d.kept[1].head = object()
+    assert d._resume(list(range(128))) is d.kept[1]
+
+
+def test_eviction_fingerprints_are_bounded_and_hold_no_state():
+    d = decoder()
+    d._settle = lambda x: None
+    for n in (64, 128, 192):
+        c = snap(n, extent=NS(kept=[]))
+        d.kept.append(c)
+        c.extent.kept.append(c)
+        d._drop(c)
+        assert c.drafter_rows is None
+    assert [n for n, _ in d.evicted_prefixes] == [128, 192]
+    assert all(len(h) == 32 for _, h in d.evicted_prefixes)
+
+
+def test_done_line_is_unchanged_when_off_and_has_one_reason_when_on(capsys):
+    for stats in ({}, {"cache_reason": "token_mismatch:17"}):
+        print_done(200, 0, False, [1, 2], "length", stats, NS(first=None))
+        line = capsys.readouterr().out
+        assert line.count("cache_reason=") == bool(stats)
+        if stats:
+            assert line.rstrip().endswith("cache_reason=token_mismatch:17")
