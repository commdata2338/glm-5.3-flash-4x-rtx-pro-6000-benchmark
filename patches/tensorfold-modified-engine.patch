+"""Real tensor arithmetic, CPU-only, including four-rank collectives and host fallbacks."""
+
+from concurrent.futures import ThreadPoolExecutor
+import threading
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.cuda import gpu_sample_unbounded as gpu
+from tensorfold.cuda import sampling as cs
+from tensorfold.engine.exact_sampling import Sampling, uniform
+from tensorfold.families.glm5_next.cuda.multi_tune import sample_packed
+
+
+@pytest.fixture(autouse=True)
+def checked_paths(monkeypatch):
+    # Communication-budget tests exclude the one-time startup vote. Self-check
+    # tests below explicitly reset it and exercise the real gate separately.
+    monkeypatch.setattr(gpu, "_state", {"full": True, "nucleus": True})
+
+
+class Ranks:
+    def __init__(self, world=4):
+        self.world = world
+        self.slots = [None] * world
+        self.barrier = threading.Barrier(world, timeout=30)
+        self.sizes = [[] for _ in range(world)]
+
+    def gather(self, rank):
+        def gather(words):
+            self.sizes[rank].append(words.numel() * words.element_size())
+            self.slots[rank] = words.clone()
+            self.barrier.wait()
+            both = torch.stack(self.slots)
+            self.barrier.wait()
+            return both
+        return gather
+
+    def run(self, fn):
+        with ThreadPoolExecutor(self.world) as pool:
+            futures = [pool.submit(fn, r, self.gather(r)) for r in range(self.world)]
+            result = [f.result(timeout=60) for f in futures]
+        assert all(x == result[0] for x in result)
+        assert all(x == self.sizes[0] for x in self.sizes)
+        return result[0]
+
+
+def test_uniform_bits():
+    seeds = [0, 1, -1, 2**63 + 91, 2**64 - 1]
+    positions = [0, 1, 2**32 + 7, 10**6, 2**63 - 1]
+    ids = torch.arange(4096)[None].expand(len(seeds), -1)
+    got = gpu.uniforms(torch.tensor([gpu._signed(s) for s in seeds]), torch.tensor(positions), ids).numpy()
+    for r, (s, p) in enumerate(zip(seeds, positions)):
+        np.testing.assert_array_equal(got[r], uniform(s, p, ids[r].numpy()))
+
+
+@pytest.mark.parametrize("temperature", [1e-7, 0.3, 1.0, 2.5])
+@pytest.mark.parametrize("widths", [[1, 1, 1, 1], [1, 17, 31, 7], [67, 67, 67, 67]])
+def test_full_four_shards_match_host(monkeypatch, temperature, widths):
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "1")
+    rng = torch.Generator().manual_seed(11)
+    x = (torch.randn(16, sum(widths), generator=rng) * 3).bfloat16()
+    x[::3] = x[::3].round()  # logit ties; keyed score ties are separately rejected below
+    x[1, :-1] = -torch.inf   # grammar: entire shards masked, one valid token
+    positions = [r * 10007 for r in range(len(x))]
+    offsets = np.cumsum([0] + widths).tolist()
+    for seed in [0, 9, -1, 2**63 + 3, 17921]:
+        s = Sampling(seed, temperature, 0, 1.0)
+        monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "0")
+        expected = cs.nucleus_rows(x, positions, s)
+        monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "1")
+        ranks = Ranks()
+        def run(r, gather):
+            return cs.nucleus_rows(x[:, offsets[r]:offsets[r + 1]], positions, s,
+                                   offset=offsets[r], gather=gather)
+        assert ranks.run(run) == expected
+        assert ranks.sizes[0] == [len(x) * 48]  # one winner exchange, no candidates
+
+
+def test_full_near_ties_are_not_certified():
+    ids = torch.tensor([[0, 1]])
+    s = Sampling(3, 1, 0, 1)
+    u = uniform(s.seed, 7, ids.numpy()[0])
+    # Construct an exact score tie before float32 logit quantization.
+    scaled = torch.from_numpy(np.log(-np.log(u)))[None]
+    got = gpu.full_local(scaled, ids, [7], [s])[None]
+    assert not gpu.full_merge(got)[1].item()
+    assert not gpu.separated(torch.tensor([1.0]), torch.tensor([1.0 + 1e-13])).item()
+
+
+def test_full_fallback_is_batched_across_streams(monkeypatch):
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "1")
+    monkeypatch.setattr(gpu, "separated", lambda a, b: torch.zeros_like(a, dtype=torch.bool))
+    x = torch.randn(5, 80, generator=torch.Generator().manual_seed(44))
+    ss = [Sampling(8, 0.7, 0, 1), Sampling(11, 1.5, 0, 1.1)]
+    positions = [[7, 8], [77, 78, 79]]
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "0")
+    expected = [cs.nucleus_rows(x[:2], positions[0], ss[0]), cs.nucleus_rows(x[2:], positions[1], ss[1])]
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "1")
+    ranks = Ranks()
+    def run(r, gather):
+        comm = SimpleNamespace(world=4, all_gather=lambda inp, out: out.copy_(gather(inp).flatten()))
+        w = SimpleNamespace(comm=comm, world=4, vocab_offset=r * 20)
+        shard = x[:, r * 20:(r + 1) * 20]
+        return sample_packed(w, [(shard[:2], positions[0], ss[0]), (shard[2:], positions[1], ss[1])])
+    assert ranks.run(run) == expected
+    assert ranks.sizes[0] == [5 * 48, 5 * (3 * 20 + 2) * 8]
+
+
+def test_id_map_and_probabilities_keep_reference(monkeypatch):
+    x = torch.tensor([[3.0, -torch.inf, 2.0, 1.0]])
+    ids = torch.tensor([40, 7, 99, 2])
+    s = Sampling(44, 1, 0, 1)
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "0")
+    probs = []
+    expected = cs.nucleus_rows(x, [91], s, id_map=ids, probs=probs)
+    monkeypatch.setenv("TENSORFOLD_GPU_SAMPLE_FULL", "1")
+    assert cs.nucleus_rows(x, [91], s, id_map=ids) == expected
+    actual_probs = []
+    assert cs.nucleus_rows(x, [91], s, id_map=ids, probs=actual_probs) == expected
+    assert actual_probs == probs
