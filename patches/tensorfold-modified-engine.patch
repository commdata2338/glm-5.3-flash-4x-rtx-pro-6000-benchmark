+class TimeCredit:
+    """Serial completed-service credit, in seconds. Only contention earns credit; idle/class changes reset it.
+
+    Decode earns share*t; prefill spends (1-share)*t. A nonpositive balance chooses decode first, then repays with
+    whole chunks. Thus overshoot is bounded by a service quantum unless a priority/deadline rule forces service.
+    """
+
+    def __init__(self, share: float) -> None:
+        self.share, self.balance, self.key = float(share), 0.0, None
+        self.seconds = {"prefill": 0.0, "decode": 0.0}
+
+    def contend(self, key) -> None:
+        if key != self.key or key is None:
+            self.balance = 0.0
+        self.key = key
+
+    def choose(self) -> bool:
+        return self.share == 1.0 or self.balance > 0.0
+
+    def record(self, fill: bool, seconds: float) -> None:
+        if self.key is None or seconds <= 0:
+            return
+        self.seconds["prefill" if fill else "decode"] += seconds
+        self.balance += (-(1.0 - self.share) if fill else self.share) * seconds
+
+
 class Arbiter:
     """Rank 0's choice, each iteration while streams decode, between the next prompt chunk and a decode round."""
 
-    def __init__(self, settings: Settings, share: float, clock: Callable[[], float] = time.monotonic) -> None:
+    def __init__(self, settings: Settings, share: float, clock: Callable[[], float] = time.monotonic,
+                 time_credit: TimeCredit | None = None) -> None:
         self.s, self.share, self.clock = settings, float(share), clock
+        self.time_credit = time_credit
         self.credit = 0.0
         self.last_round: float | None = None
         self.counts = {"chunks": 0, "rounds": 0, "starved": 0, "overdue": 0, "short": 0, "held": 0}
@@ -279,6 +307,8 @@ class Arbiter:
 
         s = self.s
         now = self.clock()
+        if self.time_credit is not None:
+            self.time_credit.contend(fill_class if fill_class == round_class else None)
         if self.last_round is not None and now - self.last_round >= s.round_gap_s:
             self.counts["overdue"] += 1
             return self._round()
@@ -293,6 +323,8 @@ class Arbiter:
             return self._chunk()
         share = (s.up_share if fill_class < round_class else s.down_share if fill_class > round_class
                  else self.share)
+        if self.time_credit is not None and self.time_credit.key is not None:
+            return self._chunk() if self.time_credit.choose() else self._round()
         self.credit = min(self.credit + share, 1.0 + share)
         if self.credit < 1.0:
             return self._round()
