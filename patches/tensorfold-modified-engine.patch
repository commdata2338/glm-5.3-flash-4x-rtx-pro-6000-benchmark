+"""Opt-in, certified top-k-off draws using tensor operations on CPU or CUDA.
+
+The score margin follows gpu_sample (patch 0065). Float64 division and integer
+keying are exact; the two logarithms can differ from NumPy by a few ulps. Only
+a finite winner separated by more than 2^-39 * max(1, abs(scores)) is accepted.
+Uncertain rows use cuda.sampling._draw, including its ordering and error cases.
+
+No CUDA extension or compiler is needed. Each collective transports fp32 words,
+including the bit patterns of int64/float64 metadata, as in cuda.sampling.
+
+Licensed under the Apache License, Version 2.0. Builds on TensorFold.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import numpy as np
+import torch
+
+from tensorfold.cuda import sampling as host
+
+SCORE_BOUND = 2.0 ** -39
+CUT_BOUND = 2.0 ** -34  # patch 0065's probability margin; also bounds integer -> double rounding
+_state = {"full": None, "nucleus": None}
+
+
+def wanted(kind: str) -> bool:
+    name = "TENSORFOLD_GPU_SAMPLE_" + kind.upper()
+    value = os.environ.get(name, "0").strip().lower() or "0"
+    if value not in ("0", "1", "off", "on"):
+        raise ValueError(f"{name}: expected 0 or 1, got {value!r}")
+    return value in ("1", "on")
+
+
+def settings_code():
+    """Startup agreement: these switches change the sequence of collectives."""
+    return (int(os.environ.get("TENSORFOLD_SAMPLE_SKIP_FUTILE", "0") == "1")
+            | (int(wanted("full")) << 1) | (int(wanted("nucleus")) << 2))
+
+
+def enabled(kind, device, gather):
+    """One first-use check and a unanimous rank vote; failures disable both new paths."""
+    if not wanted(kind):
+        return False
+    if _state[kind] is None:
+        try:
+            ok, why = check(kind, device)
+        except Exception as exc:  # no certified implementation here: keep serving through the reference
+            ok, why = False, f"{type(exc).__name__}: {str(exc).splitlines()[0][:160] if str(exc) else ''}"
+        # No rank may take a different collective path because its check failed.
+        vote = torch.tensor([int(ok)], dtype=torch.int32, device=device)
+        agreed = bool(host._stacked(gather, vote).bool().all().item())
+        if agreed:
+            _state[kind] = True
+        else:
+            _state.update(full=False, nucleus=False)
+        reason = why if not ok else "another rank failed its self-check"
+        print(f"[tensorfold] GPU sample {kind}: " + ("on (checked against host rule)" if agreed else "off: " + reason),
+              flush=True)
+    return bool(_state[kind])
+
+
+def reset():
+    """Forget process decisions (tests only)."""
+    _state.update(full=None, nucleus=None)
+
+
+def kind_for(s):
+    if s is None or s.top_k or not (s.temperature > 0 and math.isfinite(s.temperature)):
+        return None
+    if s.top_p >= 1.0 and s.min_p == 0.0:
+        return "full"
+    if 0.0 < s.top_p < 1.0 and math.isfinite(s.min_p) and s.min_p <= 1.0:
+        return "nucleus"
+    return None
+
+
+def _signed(x):
+    x = int(x) & ((1 << 64) - 1)
+    return x - (1 << 64) if x >= (1 << 63) else x
+
+
+def _rshift(x, n):
+    return (x >> n) & ((1 << (64 - n)) - 1)
+
+
+def _mix(x):
+    x = (x ^ _rshift(x, 30)) * _signed(0xBF58476D1CE4E5B9)
+    x = (x ^ _rshift(x, 27)) * _signed(0x94D049BB133111EB)
+    return x ^ _rshift(x, 31)
+
+
+def uniforms(seeds, positions, ids):
+    """Bit-identical splitmix64, with signed int64 wraparound and logical shifts."""
+    x = _mix(seeds + _signed(0x9E3779B97F4A7C15))
+    x = _mix(x ^ (positions * _signed(0xD1B54A32D192ED03)))
+    x = _mix(x[:, None] ^ ids)
+    return _rshift(x, 11).double() * 2.0 ** -53 + 2.0 ** -54
+
+
+def _scores(scaled, ids, positions, samplings):
+    seeds = torch.tensor([_signed(s.seed) for s in samplings], dtype=torch.int64, device=scaled.device)
+    pos = torch.tensor([_signed(p) for p in positions], dtype=torch.int64, device=scaled.device)
+    return scaled - torch.log(-torch.log(uniforms(seeds, pos, ids)))
+
+
+def separated(best, second):
+    scale = torch.maximum(best.abs(), second.abs()).clamp_min(1.0)
+    return torch.isfinite(best) & (torch.isneginf(second) | ((best - second) > SCORE_BOUND * scale))
+
+
+def full_local(scaled, ids, positions, samplings):
+    """Six int64 words/row: score, runner-up score, winner ID, valid, width, max logit."""
+    score = _scores(scaled, ids, positions, samplings)
+    valid = ~(torch.isnan(score) | torch.isposinf(score) | torch.isnan(scaled)).any(dim=1)
+    score = score.nan_to_num(nan=-math.inf, posinf=-math.inf, neginf=-math.inf)
+    if score.shape[1] < 2:
+        score = torch.cat([score, score.new_full((len(score), 2 - score.shape[1]), -math.inf)], dim=1)
+    best, cols = torch.topk(score, 2, dim=1)
+    token = ids.gather(1, cols[:, :1].clamp_max(ids.shape[1] - 1))
+    width = torch.full_like(token, ids.shape[1])
+    top = scaled.max(dim=1, keepdim=True).values
+    return torch.cat([best.view(torch.int64), token, valid[:, None].long(), width, top.view(torch.int64)], dim=1)
+
+
+def full_merge(got):
+    """Global best/runner-up of local best pairs, and the global numeric certificate."""
+    world, rows, _ = got.shape
+    scores = got[:, :, :2].contiguous().view(torch.float64).permute(1, 0, 2).reshape(rows, 2 * world)
+    best = torch.topk(scores, 2, dim=1).values
+    rank = got[:, :, 0].contiguous().view(torch.float64).argmax(dim=0)
+    tokens = got[:, :, 2].gather(0, rank[None]).squeeze(0)
+    certain = got[:, :, 3].bool().all(dim=0) & separated(best[:, 0], best[:, 1])
+    return tokens, certain
+
+
+def _fallback(scaled, mass, ids, positions, samplings, gather, width):
+    """ONE full-shard gather for all unresolved rows across streams, then the original host rule."""
+    rows, local_width = scaled.shape
+    pad = width - local_width
+    if pad:
+        scaled = torch.cat([scaled, scaled.new_full((rows, pad), -math.inf)], dim=1)
+        ids = torch.cat([ids, ids.new_full((rows, pad), -1)], dim=1)
+        kept = torch.cat([mass, mass.new_zeros((rows, pad))], dim=1)
+    else:
+        kept = mass
+    widths = torch.full((rows, 1), local_width, dtype=torch.int64, device=scaled.device)
+    pack = torch.cat([scaled.view(torch.int64), ids, kept, mass.sum(dim=1, keepdim=True), widths], dim=1)
+    both = host._stacked(gather, pack).cpu().numpy()
+    result = []
+    for r, (pos, s) in enumerate(zip(positions, samplings)):
+        b = both[:, r:r + 1]
+        got = (np.ascontiguousarray(b[:, :, :width]).view(np.float64), b[:, :, width:2 * width],
+               b[:, :, 2 * width:3 * width], b[:, :, 3 * width], b[:, :, 3 * width + 1])
+        result.append(host._draw(got, [pos], s)[0][0])
+    return result
+
+
+def full_rows(scaled, ids, positions, samplings, gather):
+    got = host._stacked(gather, full_local(scaled, ids, positions, samplings))
+    tokens, certain = full_merge(got)
+    widths = got[:, :, 4].max(dim=0).values
+    # Only tokens, flags and shard widths reach the host on a certified call.
+    result = torch.stack([tokens, certain.long(), widths], dim=1).cpu().tolist()
+    missing = [r for r, (_, ok, _) in enumerate(result) if not ok]
+    if missing:
+        x = scaled[missing]
+        top = got[:, :, 5].contiguous().view(torch.float64).max(dim=0).values[missing]
+        mass = torch.floor(torch.exp(x - top[:, None]) * host.MASS).long()
+        redo = _fallback(x, mass, ids[missing], [positions[r] for r in missing], [samplings[r] for r in missing],
+                         gather, max(result[r][2] for r in missing))
+        for r, token in zip(missing, redo):
+            result[r][0] = token
+    return [row[0] for row in result]
+
+
+def nucleus_pack(scaled, mass, ids, count):
+    """The release's (value bits, ID, integer mass, shard sum, width) pack, kept on device."""
+    rows, width = scaled.shape
+    vals, cols = torch.topk(scaled, min(width, count), dim=1)
+    tokens, kept = ids.gather(1, cols), mass.gather(1, cols)
+    pad = count - vals.shape[1]
+    if pad:
+        vals = torch.cat([vals, vals.new_full((rows, pad), -math.inf)], dim=1)
+        tokens = torch.cat([tokens, tokens.new_full((rows, pad), -1)], dim=1)
+        kept = torch.cat([kept, kept.new_zeros((rows, pad))], dim=1)
+    widths = torch.full((rows, 1), width, dtype=torch.int64, device=scaled.device)
+    return torch.cat([vals.view(torch.int64), tokens, kept, mass.sum(dim=1, keepdim=True), widths], dim=1)
+
+
+def nucleus_merge(got, positions, samplings):
+    """Certified integer-mass nucleus and keyed draw from a gathered device pack.
+
+    Masses are the SAME torch floor(exp(...)*2^40) int64 values as the release,
+    computed on the same device (no NumPy exp is substituted). Sort and cumsum
+    are exact. Fraction(top_p)*total is bounded by a double approximation: for
+    positive int64 totals its absolute error is < 2^-50 * total + 1. Requiring
+    every cumulative mass to be > 2^-34 * total + 4 away proves the comparisons
+    against the reference's exact rational cut, including ceil and equality.
+    Close cuts fall back, rather than replacing the reference with a float cut.
+    """
+    world, rows, size = got.shape
+    n = (size - 2) // 3
+    vals = got[:, :, :n].contiguous().view(torch.float64)
+    ids, mass = got[:, :, n:2 * n], got[:, :, 2 * n:3 * n]
+    widths = got[:, :, -1]
+    v = vals.permute(1, 0, 2).reshape(rows, -1)
+    i = ids.permute(1, 0, 2).reshape(rows, -1)
+    m = mass.permute(1, 0, 2).reshape(rows, -1)
+    # Stable value sort after ID sort is np.lexsort((ids, -values)).
+    by_id = torch.argsort(i, dim=1, stable=True)
+    by_value = torch.argsort(v.gather(1, by_id), dim=1, descending=True, stable=True)
+    order = by_id.gather(1, by_value)
+    v, i, m = v.gather(1, order), i.gather(1, order), m.gather(1, order)
+    total = got[:, :, -2].sum(dim=0)
+    cum = m.cumsum(dim=1)
+    p = torch.tensor([s.top_p for s in samplings], dtype=torch.float64, device=v.device)
+    target = total.double() * p
+    # The cut is certified below; no uncertain rounded comparison can select a token.
+    below = cum.double() < target[:, None]
+    keep = below.sum(dim=1) + 1
+    near_cut = ((cum.double() - target[:, None]).abs() <= (CUT_BOUND * total.double() + 4)[:, None]).any(dim=1)
+    cut_value = v.gather(1, (keep - 1).clamp_max(v.shape[1] - 1)[:, None]).squeeze(1)
+    complete = (ids >= 0).sum(dim=2) == widths
+    # Strictly above each partial shard's last value excludes every unsent token,
+    # even tied logits. This is _union_covers' proof, independent of its env switch.
+    last = vals.masked_fill(ids < 0, math.inf).min(dim=2).values
+    covered = (complete | (cut_value[None] > last)).all(dim=0) & (cum[:, -1].double() >= target)
+    min_log = torch.tensor([s.min_log for s in samplings], dtype=torch.float64, device=v.device)
+    floor = v[:, 0] + min_log
+    eligible = (torch.arange(v.shape[1], device=v.device)[None] < keep[:, None]) & (v >= floor[:, None]) & (i >= 0)
+    score = _scores(v, i, positions, samplings).masked_fill(~eligible, -math.inf)
+    values, cols = torch.topk(score, 2, dim=1)
+    tokens = i.gather(1, cols[:, :1]).squeeze(1)
+    valid = ((total > 0) & (m >= 0).all(dim=1) & ~(torch.isnan(v) | torch.isposinf(v)).any(dim=1)
+             & ~torch.isnan(score).any(dim=1))
+    certain = valid & covered & ~near_cut & separated(values[:, 0], values[:, 1])
+    return tokens, certain, covered
+
+
+def nucleus_rows(scaled, ids, positions, samplings, gather):
+    top = host._stacked(gather, scaled.max(dim=1).values).max(dim=0).values
+    mass = torch.floor(torch.exp(scaled - top[:, None]) * host.MASS).long()
+    result = [None] * len(positions)
+    pending = list(range(len(positions)))
+    fallback = []
+    width = 0
+    for count in (host.NUCLEUS, host.WIDER):
+        got = host._stacked(gather, nucleus_pack(scaled[pending], mass[pending], ids[pending], count))
+        tokens, certain, covered = nucleus_merge(got, [positions[r] for r in pending], [samplings[r] for r in pending])
+        widths = got[:, :, -1].max(dim=0).values
+        # Log implementations can differ across devices. Agree on tokens and the
+        # fallback mask BEFORE branching into more collectives (including retries).
+        votes = host._stacked(gather, torch.stack([tokens, certain.long(), covered.long(), widths], dim=1))
+        tokens = votes[0, :, 0]
+        certain = votes[:, :, 1].bool().all(dim=0) & (votes[:, :, 0] == tokens[None]).all(dim=0)
+        covered = votes[:, :, 2].bool().all(dim=0)
+        widths = votes[:, :, 3].max(dim=0).values
+        # One small readback for all streams, never a candidate read on certified rows.
+        status = torch.stack([tokens, certain.long(), covered.long(), widths], dim=1).cpu().tolist()
+        retry = []
+        for r, (token, ok, cover, w) in zip(pending, status):
+            width = max(width, w)
+            if ok:
+                result[r] = token
+            elif not cover and count == host.NUCLEUS and w > host.WIDER and host.union_cover():
+                retry.append(r)
+            else:
+                fallback.append(r)
+        pending = retry
+        if not pending:
+            break
+    if fallback:
+        redo = _fallback(scaled[fallback], mass[fallback], ids[fallback], [positions[r] for r in fallback],
+                         [samplings[r] for r in fallback], gather, width)
+        for r, token in zip(fallback, redo):
+            result[r] = token
+    return result
+
+
+def sample_parts(parts, *, offset=0, id_map=None, gather=host.one_rank):
+    """Return tokens for eligible parts and None for others; batch every stream of a kind."""
+    out = [None] * len(parts)
+    for kind, draw in (("full", full_rows), ("nucleus", nucleus_rows)):
+        members = [k for k, (x, _, s) in enumerate(parts) if kind_for(s) == kind and x.shape[0]]
+        if not members or not enabled(kind, parts[members[0]][0].device, gather):
+            continue
+        xs, positions, samplings = [], [], []
+        for k in members:
+            x, pos, s = parts[k]
+            if len(pos) != x.shape[0]:
+                raise ValueError("one position per real sampling row is required")
+            xs.append(x.float().double() / max(float(s.temperature), 1e-6))
+            positions.extend(pos)
+            samplings.extend([s] * len(pos))
+        scaled = torch.cat(xs)
+        ids = (torch.arange(scaled.shape[1], device=scaled.device) + offset if id_map is None else id_map.long())
+        ids = ids[None].expand(scaled.shape)
+        drawn = draw(scaled, ids, positions, samplings, gather)
+        at = 0
+        for k in members:
+            n = len(parts[k][1])
+            out[k], at = drawn[at:at + n], at + n
+    return out
+
+
+def check(kind, device, rows=96, seed=7361):
+    """Random four-rank candidate packs, compared with the release's host rule.
+
+    This runs the actual tensor arithmetic on the requested device, not a CPU
+    emulation of CUDA. It needs no distributed group; enabled() votes afterward.
+    """
+    from tensorfold.engine.exact_sampling import Sampling
+
+    rng = np.random.default_rng(seed)
+    world, n = 4, 32
+    values = rng.normal(0, 3, (world, rows, n)).astype(np.float32)
+    values[:, ::3] = np.round(values[:, ::3])
+    values[:, ::7, :n // 2] = -np.inf
+    # Each token ID occurs exactly once per row, with deliberately scrambled order.
+    ids = np.stack([rng.permutation(world * n) for _ in range(rows)], axis=0).reshape(rows, world, n).transpose(1, 0, 2)
+    positions = rng.integers(0, 1 << 32, rows).tolist()
+    settings = [Sampling(int(rng.integers(0, 2**63)) + (2**63 if r % 2 else 0),
+                         [1e-7, 0.3, 0.8, 1.0, 2.0][r % 5], 0,
+                         1.0 if kind == "full" else [0.5, 0.83, 0.95, 0.99][r % 4],
+                         0.0 if kind == "full" else [0.0, 0.05][r % 2]) for r in range(rows)]
+    temp = torch.tensor([max(s.temperature, 1e-6) for s in settings], dtype=torch.float64, device=device)
+    x = torch.from_numpy(values).to(device).double() / temp[None, :, None]
+    tok = torch.from_numpy(np.ascontiguousarray(ids)).to(device)
+    top = x.amax(dim=(0, 2))
+    mass = torch.floor(torch.exp(x - top[None, :, None]) * host.MASS).long()
+    packs = torch.stack([nucleus_pack(x[q], mass[q], tok[q], n) for q in range(world)])
+    if kind == "full":
+        summaries = torch.stack([full_local(x[q], tok[q], positions, settings) for q in range(world)])
+        tokens, certain = full_merge(summaries)
+    elif kind == "nucleus":
+        tokens, certain, _ = nucleus_merge(packs, positions, settings)
+    else:
+        raise ValueError(kind)
+    actual = tokens.cpu().tolist()
+    certified = certain.cpu().tolist()
+    both = packs.cpu().numpy()
+    bad = 0
+    for r, (pos, s) in enumerate(zip(positions, settings)):
+        b = both[:, r:r + 1]
+        got = (np.ascontiguousarray(b[:, :, :n]).view(np.float64), b[:, :, n:2*n], b[:, :, 2*n:3*n],
+               b[:, :, 3*n], b[:, :, 3*n + 1])
+        expected = host._draw(got, [pos], s)[0][0]
+        bad += bool(certified[r] and actual[r] != expected)
+    if bad:
+        return False, f"{bad} of {rows} certified tokens differ from host rule"
+    if sum(certified) < 0.9 * rows:
+        return False, f"only {sum(certified)} of {rows} rows certified"
+    return True, ""
