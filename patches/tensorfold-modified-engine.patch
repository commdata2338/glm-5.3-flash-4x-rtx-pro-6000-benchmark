diff --git a/tests/test_glm_burst_prefix.py b/tests/test_glm_burst_prefix.py
new file mode 100644
index 0000000..58d8ff1
--- /dev/null
+++ b/tests/test_glm_burst_prefix.py
@@ -0,0 +1,272 @@
+"""Real admission, pool, snapshot and rank protocol with CPU tensors and a deterministic fake forward.
+
+The existing glm5_fakes builds MLX checkpoints, and cuda/prefix_checks runs real GPU forwards. This fixture uses
+their prefix-equality approach at the GLM concurrent seam, without allocating CUDA tensors or importing MLX.
+"""
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+from tensorfold.cuda.streams import Stream
+from tensorfold.families.glm5_next.cuda import decode, forward, multi
+from tensorfold.families.glm5_next.cuda.pool import Arena, Plane
+
+
+class State:
+    def __init__(self, w, capacity, rows, *, caches, base, slots, slot):
+        self.rec, self.conv, self.cur = torch.zeros(2, 1), torch.zeros(4), [0]
+        self.index, self.kc, self.mtp_len = [], [], 0
+        self.caches = caches
+        self.bind(base, capacity)
+        self.reset()
+
+    def bind(self, base, size):
+        self.base, self.capacity = base, size
+        self.kc = [self.caches.arena.planes[0].view(base, size)]
+
+    def reset(self):
+        self.rec.zero_()
+        self.conv.zero_()
+        self.cur, self.pos = [0], 0
+
+    def set_pos(self, pos):
+        self.pos = pos
+
+
+class Context:
+    def __init__(self):
+        self.ring, self.window = 16, 7
+        self.kc, self.vc = [torch.zeros(1, 16, 1)], [torch.zeros(1, 16, 1)]
+        self.pos_dev = torch.tensor(0)
+        self.reset()
+
+    def reset(self):
+        for c in self.kc + self.vc:
+            c.zero_()
+        self.context_end = 0
+        self.pos_dev.zero_()
+
+
+@pytest.fixture
+def factory(monkeypatch):
+    monkeypatch.setattr(forward, "State", State)
+    monkeypatch.setenv("TF_GLM_MULTI_PREFILL", "0")
+    monkeypatch.setenv("TF_GLM_MULTI_WATCHDOG_S", "0")
+    monkeypatch.setenv("TF_GLM_CACHE_REASONS", "1")
+
+    def prefill(e, prompt, start, rows, *, drafter, reads, **kw):
+        st = e.st
+        assert st.pos == start
+        e.reads.append((start, rows, tuple(reads)))
+        for p in range(start, start + rows):
+            token = prompt[p]
+            st.rec[0] += token
+            st.conv = torch.cat((st.conv[1:], torch.tensor([float(token)])))
+            st.kc[0][p] = token
+            if drafter is not None:
+                drafter.kc[0][0, p % 16, 0] = token
+                drafter.vc[0][0, p % 16, 0] = token * 2
+        st.set_pos(start + rows)
+        if drafter is not None:
+            drafter.context_end = st.pos
+        # Include all copied state in the result, making stale/missing copies observable.
+        value = st.rec[0].item() + st.conv.sum().item() + st.kc[0][:st.pos].sum().item()
+        if drafter is not None:
+            value += sum(t.sum().item() for t in multi.draft_window(drafter, st.pos))
+        logits = torch.zeros(1, 97)
+        logits[0, int(value) % 97] = 10
+        return logits
+
+    monkeypatch.setattr(decode, "prefill_chunk", prefill)
+
+    def make(burst=True, *, entries=32, streams=8):
+        monkeypatch.setenv("TF_GLM_BURST_PREFIX", str(int(burst)))
+        arena = Arena(32768, [Plane(torch.zeros(32768, 1))])
+        w = NS(cfg=NS(eos=()), vocab_offset=0, comm=None, world=1, device=torch.device("cpu"))
+        e = NS(w=w, caches=NS(rows=32768, arena=arena), slots=NS(count=streams), rows=16,
+               prefill_rows=128, reads=[], st=None)
+        def use(st):
+            prev, e.st = e.st, st
+            return prev
+        e.use = use
+        g = NS(e=e, rank=0, grid=64, drafter=None, limit=16384, serial_only=False,
+               shared=0, opener=None, costs=None, copy=None, cache_entries=entries, vision=None,
+               _ring=lambda: None, _share=lambda msg: None)
+        drafts = NS(contexts=[Context() for _ in range(streams)])
+        return multi.MultiDecoder(g, streams, verify=object(), drafts=drafts,
+                                  tune=multi.MultiSettings(lone=False))
+    return make
+
+
+def request(prompt, **kw):
+    s = Stream(list(prompt), 1, **kw)
+    s.glm = {"code": [11, 1, 0, 0]}
+    return s
+
+
+def complete(d, streams):
+    for s in streams:
+        d.admit(s)
+    for _ in range(100):
+        if not d.live():
+            break
+        d.finish(d.round())
+    assert not d.live()
+    return [s.out for s in streams]
+
+
+@pytest.mark.parametrize("entries", [1, 32])
+def test_four_siblings_read_shared_rows_once_and_keep_the_same_answers(factory, entries):
+    prompts = [list(range(300)) + [k] * 22 for k in range(4)]
+    off, on = factory(False), factory(entries=entries)
+    expected = complete(off, [request(p) for p in prompts])
+    streams = [request(p) for p in prompts]
+    assert complete(on, streams) == expected
+    assert [s.cached for s in streams] == [0, 256, 256, 256]
+    assert sum(rows for _, rows, _ in off.e.reads) == 4 * 322
+    assert sum(rows for _, rows, _ in on.e.reads) == 256 + 4 * 66
+    assert all(256 in reads for start, _, reads in on.e.reads if start < 256)
+
+
+def test_rank_zero_protocol_restores_all_state_with_follower_switch_off(factory):
+    leader, follower = factory(), factory(False)
+    follower.rank = 1
+    leader.g._share = follower.apply
+    prompts = [list(range(300)) + [k] * 22 for k in range(4)]
+    streams = [request(p) for p in prompts]
+    for s in streams:
+        leader.admit(s)
+    for _ in range(3):
+        leader.round()
+    # The third iteration carries checkpoint resume; its fill is applied on both ranks.
+    for sid, a in leader.lanes.items():
+        b = follower.lanes[sid]
+        assert a.st.pos == b.st.pos and a.s.cached == b.s.cached
+        assert torch.equal(a.st.rec, b.st.rec) and torch.equal(a.st.conv, b.st.conv)
+        assert torch.equal(a.st.kc[0][:a.st.pos], b.st.kc[0][:b.st.pos])
+        for x, y in zip(multi.draft_window(leader._ctx(a), a.st.pos),
+                        multi.draft_window(follower._ctx(b), b.st.pos)):
+            assert torch.equal(x, y)
+    assert [s.cached for s in streams] == [0, 256, 256, 256]
+
+
+def test_priorities_vision_serial_and_unavailable_drafter_windows_are_not_coalesced(factory):
+    d = factory()
+    a, b = request(range(322)), request(range(322), priority=0)
+    d.admit(a)
+    d.admit(b)
+    d._burst_plan()
+    assert not d.burst_wait
+    b.priority = a.priority
+    b.prompt = list(range(300)) + [-1] * 22
+    d.lanes[a.sid].st.pos = 64
+    d._ctx(d.lanes[a.sid]).window = 256    # new point 256 would need taps before the current position
+    d._burst_plan()
+    assert not d.burst_wait
+    d.lanes[a.sid].st.pos = 0
+    d.lanes[a.sid].feed = object()
+    d._burst_plan()
+    assert not d.burst_wait
+    d.lanes[a.sid].feed = None
+    a.draft = False
+    d._burst_plan()
+    assert not d.burst_wait
+
+
+@pytest.mark.parametrize("finish", [False, True])
+def test_missing_producer_or_evicted_checkpoint_releases_waiters(factory, finish):
+    d = factory()
+    a, b = request(range(322)), request(range(322))
+    d.admit(a)
+    d.admit(b)
+    d.round()
+    assert b.sid in d.burst_wait
+    if finish:
+        d._finish(a.sid)
+    else:
+        while d.lanes[a.sid].st.pos < d.burst_wait[b.sid][1]:
+            d.round()
+        for c in list(d.kept):
+            d._drop(c)
+    d._burst_plan()
+    assert b.sid not in d.burst_wait
+    assert d._fill_turn() is not None
+
+
+def test_whole_head_replay_and_new_turn_keep_the_grid_prefix(factory):
+    d = factory()
+    first = request(range(320))
+    complete(d, [first])
+    replay = request(range(320))
+    complete(d, [replay])
+    assert replay.cached == 320 and replay.out == first.out
+    turn = request(list(range(320)) + [80, 81, 82])
+    expected = complete(factory(False), [request(turn.prompt)])
+    assert complete(d, [turn]) == expected and turn.cached == 320
+
+
+def test_resume_rejects_wrong_tokens_and_partial_consumer(factory):
+    d = factory()
+    a = request(range(320))
+    complete(d, [a])
+    hit = d.kept[-1]
+    b = request([999] + list(range(1, 322)))
+    d.admit(b)
+    with pytest.raises(RuntimeError, match="invalid burst resume"):
+        d._resume_lane(d.lanes[b.sid], hit)
+    b.prompt = list(range(322))
+    d.lanes[b.sid].st.pos = 1
+    with pytest.raises(RuntimeError, match="invalid burst resume"):
+        d._resume_lane(d.lanes[b.sid], hit)
+
+
+def test_placement_refusal_is_logged_without_claiming_a_hit(factory, monkeypatch):
+    d = factory(False)
+    a = request(range(320))
+    d.admit(a)
+    while not a.done:
+        d.round()
+    # Source extent still has a writer; refuse a protected copy, then permit ordinary fresh placement.
+    room = d._room
+    monkeypatch.setattr(d, "_room", lambda need, protect=(): None if protect else room(need))
+    b = request(range(322))
+    d.admit(b)
+    assert b.cached == 0 and d.stats(b)["cache_reason"] == "no_room"
+
+
+def test_grouped_prefill_cannot_evict_a_producer_before_resume(factory):
+    d = factory(entries=1)
+    d.group = True
+    a, b = request(range(322)), request(range(322))
+    d.admit(a)
+    d.admit(b)
+    d._burst_plan()
+    assert d._group(d.lanes[a.sid]) is None
+
+
+def test_siblings_arriving_after_first_chunk_use_the_partial_producer(factory):
+    d = factory()
+    a = request(list(range(300)) + [0] * 22)
+    d.admit(a)
+    d.round()
+    assert d.lanes[a.sid].st.pos == 128
+    rest = [request(list(range(300)) + [i] * 22) for i in (1, 2, 3)]
+    complete(d, rest)
+    assert [s.cached for s in rest] == [256, 256, 256]
+    assert sum(rows for _, rows, _ in d.e.reads) == 256 + 4 * 66
+    for s in [a] + rest:
+        assert s.out == complete(factory(False), [request(s.prompt)])[0]
+
+
+def test_existing_read_is_safe_near_a_partial_producer_but_new_skipped_window_is_not(factory):
+    d = factory()
+    a = request(range(322))
+    d.admit(a)
+    lane = d.lanes[a.sid]
+    lane.st.pos = 128
+    d._ctx(lane).window = 256
+    assert not d._can_checkpoint(lane, 256)
+    assert d._can_checkpoint(lane, 320)  # prompt's ordinary grid point was in reads from the beginning
+    with pytest.raises(RuntimeError, match='invalid burst checkpoint'):
+        d._checkpoint(lane, 256)
